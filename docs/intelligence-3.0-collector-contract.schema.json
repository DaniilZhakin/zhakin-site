{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xn--80alhhq.xn--p1ai/schemas/intelligence-3.0-collector-event.schema.json",
  "title": "ZHAKIN TEAM Intelligence 3.0 Collector Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "path", "schema_version"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["page_view", "navigation_click", "menu_toggle", "outbound_click", "contact_interest", "contact_action"]
    },
    "path": {
      "type": "string",
      "pattern": "^/[^?#]*$",
      "maxLength": 512
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "referrer_class": {
      "type": "string",
      "enum": ["internal", "search", "social", "direct", "other"],
      "maxLength": 32
    },
    "content_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 128
    },
    "schema_version": {
      "type": "string",
      "const": "3.0"
    }
  }
}
