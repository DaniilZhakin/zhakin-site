{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhakin.ru/schemas/security-robot-incident-event.schema.json",
  "title": "ZHAKIN Security Robot Incident Event",
  "description": "Synthetic/offline incident journal contract. It records observations and decisions; it does not authorize operational actions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "idempotency_key",
    "incident_id",
    "event_type",
    "occurred_at",
    "recorded_at",
    "severity",
    "classification",
    "summary",
    "sources",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "event_type": {
      "enum": [
        "opened",
        "updated",
        "severity_changed",
        "decision_recorded",
        "resolved",
        "reopened"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "hypotheses",
        "recommendations"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sources": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "observed_at",
          "reference"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "human_approval_required"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending_review",
            "accepted",
            "rejected",
            "deferred",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "human_approval_required": {
          "const": true
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "supersedes_event_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    }
  }
}
