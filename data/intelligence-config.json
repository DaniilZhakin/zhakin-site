{
  "schema_version": "1.0",
  "service": "zhakin-ai",
  "status": "analytics-backend-ready",
  "endpoint": "",
  "knowledge_core": "/data/zhak-knowledge.json",
  "public_context": {
    "institutional_registry": "/data/institutional-registry.json",
    "institutional_page": "/institutional.html",
    "projects_page": "/projects.html",
    "publications_page": "/publications.html"
  },
  "security": {
    "api_key_client_side": false,
    "backend_required": true,
    "note": "The model API key must remain server-side. The browser may call only the public backend endpoint."
  },
  "analytics": {
    "provider": "posthog",
    "period_default": "-7d",
    "capabilities": [
      "visitors",
      "sessions",
      "pageviews",
      "traffic",
      "top-pages",
      "engagement"
    ],
    "server_side_only": true,
    "env": [
      "POSTHOG_HOST",
      "POSTHOG_PROJECT_ID",
      "POSTHOG_API_KEY"
    ]
  }
}
