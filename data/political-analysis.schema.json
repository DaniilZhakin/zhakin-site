{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xn--80alhhq.xn--p1ai/data/political-analysis.schema.json",
  "title": "Жакин.рф — Political Analysis Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "scope",
    "public_route",
    "purpose",
    "object_types",
    "record_contract",
    "analytical_dimensions",
    "scenario_framework",
    "quality_controls",
    "data_policy",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scope": {
      "const": "political-analysis"
    },
    "public_route": {
      "const": "/political-analysis.html"
    },
    "purpose": {
      "type": "string"
    },
    "object_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "record_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "analytical_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scenario_framework": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "quality_controls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "political_affiliation_claims",
        "sensitive_current_data_requires_date",
        "source_required_for_entity_records",
        "review_before_publication",
        "analytical_neutrality"
      ],
      "properties": {
        "political_affiliation_claims": {
          "const": "prohibited_without_explicit_source"
        },
        "sensitive_current_data_requires_date": {
          "type": "boolean"
        },
        "source_required_for_entity_records": {
          "type": "boolean"
        },
        "review_before_publication": {
          "type": "boolean"
        },
        "analytical_neutrality": {
          "type": "boolean"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "object_type",
          "status",
          "source",
          "source_date",
          "last_reviewed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "object_type": {
            "type": "string",
            "enum": [
              "party",
              "movement",
              "coalition",
              "institution",
              "electoral-system",
              "political-technology",
              "public-actor",
              "communication-environment"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "historical",
              "under-review",
              "draft"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "last_reviewed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "jurisdiction": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "program_position": {
            "type": "string"
          },
          "organizational_model": {
            "type": "string"
          },
          "electoral_profile": {
            "type": "string"
          },
          "resources": {
            "type": "string"
          },
          "communications": {
            "type": "string"
          },
          "relations": {
            "type": "array"
          },
          "scenario_notes": {
            "type": "object"
          }
        }
      }
    }
  }
}
